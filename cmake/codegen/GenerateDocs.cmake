    file(REMOVE_RECURSE "${DOCS_OUT}")
endif()
file(MAKE_DIRECTORY "${DOCS_OUT}")

set_property(GLOBAL PROPERTY config.root "${ROOT_DIR}")
set_property(GLOBAL PROPERTY config.docs_out "${DOCS_OUT}")
set_property(GLOBAL PROPERTY config.frag_dir "${DOCS_OUT}/.fragments")
