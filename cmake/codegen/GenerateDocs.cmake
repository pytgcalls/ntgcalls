file(GLOB _tpls "${DOCS_DIR}/*.tpl")
foreach(_t ${_tpls})
    if(NOT _t MATCHES "/9[0-9]-[^/]*\\.tpl$")
        render_template("${_t}")
    endif()
endforeach()
_docs_example_marks()
foreach(_t ${_tpls})
    if(_t MATCHES "/9[0-9]-[^/]*\\.tpl$")
        render_template("${_t}")
    endif()
endforeach()

file(REMOVE_RECURSE "${DOCS_OUT}/.fragments")
_docs_write_index("${DOCS_OUT}/files-list.xml")

